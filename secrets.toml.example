# Copy this file to .streamlit/secrets.toml for local runs, or paste its
# contents into Streamlit Community Cloud → App → Settings → Secrets.
# NEVER commit the real secrets.toml to GitHub.
#
# Values come from the service-account JSON key you download from Google Cloud.
# Keep private_key in triple quotes exactly as it appears in the JSON
# (the literal "\n" sequences are fine).

[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "0123456789abcdef0123456789abcdef01234567"
private_key = """-----BEGIN PRIVATE KEY-----
PASTE-YOUR-PRIVATE-KEY-HERE
-----END PRIVATE KEY-----
"""
client_email = "jig2-dashboard@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/jig2-dashboard%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# Optional settings (defaults shown)
[app_settings]
# Time zone the logger writes timestamps in, also used for "last refresh" display
display_timezone = "Asia/Kolkata"
# How to read text dates like 03/11/2026: "auto" (detects from the data;
# ambiguous → day-first), "dayfirst" (dd/mm/yyyy) or "monthfirst" (mm/dd/yyyy).
# Real date-formatted cells in the sheet are always read unambiguously.
timestamp_order = "auto"
